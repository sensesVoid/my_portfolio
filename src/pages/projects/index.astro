---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '@/components/ProjectCard.astro';

const projects = await getCollection('projects');
const featured = projects.find(p => p.data.featured);
const others = projects.filter(p => !p.data.featured);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: projects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareProject',
      name: p.data.title,
      description: p.data.description,
      url: `https://gerald-aton.vercel.app/projects/${p.slug}`,
      programmingLanguage: p.data.stack,
    },
  })),
};
---

<BaseLayout title="Projects — Gerald B. Aton" description="Open-source projects: SQAC (LLM memory), Pyralis (small LLM), Wizky CLI (local AI), and agent harness workflows." jsonLd={jsonLd}>
  <section class="section pt-24" aria-labelledby="projects-heading">
    <div class="container-custom">
      <p class="eyebrow mb-6">Projects</p>
      <h1 id="projects-heading" class="font-display text-5xl sm:text-6xl font-medium text-brand-text leading-tight mb-6 max-w-3xl">
        Open-source tools for LLM memory, small models, and local AI.
      </h1>
      <p class="text-brand-muted max-w-2xl leading-relaxed mb-12">
        SQAC is the flagship. The rest are research and tooling that feed into it.
      </p>

      {featured && (
        <section class="mb-16 border-t border-brand-border pt-12" aria-labelledby="featured-heading">
          <p class="eyebrow mb-8">Featured</p>
          <ProjectCard {...featured.data} href={`/projects/${featured.slug}`} featured={true} />
        </section>
      )}

      <section aria-labelledby="other-heading" class="border-t border-brand-border pt-12">
        <p class="eyebrow mb-8">Other work</p>
        <p class="text-brand-muted mb-8 max-w-2xl">All public work lives at <a href="https://github.com/sensesVoid" class="link">github.com/sensesVoid</a> — Pyralis, Wizky, agent harness workflows, and research repos.</p>
        <div>
          {others.map(p => <ProjectCard key={p.slug} {...p.data} href={`/projects/${p.slug}`} />)}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
