---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import { getEntry } from 'astro:content';
import Icon from '@/components/Icon.astro';

const page = await getEntry('pages', 'contact');

const serviceOptions = [
  { value: 'trust-safety', label: 'Trust & Safety Foundations' },
  { value: 'support-qa', label: 'Support Operations & QA' },
  { value: 'ai-automation', label: 'AI Automation & Tooling' },
  { value: 'fractional-qa', label: 'Fractional QA Lead' },
  { value: 'other', label: 'Other' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Gerald B. Aton',
  url: 'https://myportfolio-theta-plum-30.vercel.app/contact',
  mainEntity: {
    '@type': 'Person',
    name: 'Gerald B. Aton',
    email: 'mailto:geraldaton20@gmail.com',
    url: 'https://myportfolio-theta-plum-30.vercel.app',
  },
};
---

<BaseLayout title={page.data.title} description={page.data.description} jsonLd={jsonLd}>
  <section class="section pt-24" aria-labelledby="contact-hero">
    <div class="container-custom">
      <div class="max-w-3xl mb-12">
        <p class="eyebrow mb-6">Contact</p>
        <h1 class="font-display text-5xl sm:text-6xl font-medium text-brand-text leading-tight mb-6">
          Book a discovery call.
        </h1>
        <p class="text-brand-muted max-w-xl leading-relaxed">
          Tell me about your project. I respond within one business day.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-16 border-t border-brand-border pt-12">
        <ScrollReveal delay={1}>
          <section aria-labelledby="form-heading">
            <p class="eyebrow mb-6">Send a message</p>
            <form action="/api/contact" method="POST" class="space-y-5" id="contact-form">
              <input type="hidden" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />

              <div>
                <label for="name" class="block text-sm font-medium text-brand-text mb-1">Name</label>
                <input type="text" id="name" name="name" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text placeholder-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent" placeholder="Your name" />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-brand-text mb-1">Email</label>
                <input type="email" id="email" name="email" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text placeholder-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent" placeholder="you@example.com" />
              </div>

              <div>
                <label for="company" class="block text-sm font-medium text-brand-text mb-1">Company</label>
                <input type="text" id="company" name="company" class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text placeholder-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent" placeholder="Optional" />
              </div>

              <div>
                <label for="service" class="block text-sm font-medium text-brand-text mb-1">Service interest</label>
                <select id="service" name="service" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent">
                  <option value="">Select...</option>
                  {serviceOptions.map(opt => <option key={opt.value} value={opt.value}>{opt.label}</option>)}
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-brand-text mb-1">Message</label>
                <textarea id="message" name="message" rows="5" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text placeholder-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent resize-y" placeholder="Tell me about your project..."></textarea>
              </div>

              <button type="submit" class="btn-primary" id="submit-btn">Send message</button>
              <p class="text-xs text-brand-muted">By submitting, you agree to be contacted regarding your inquiry.</p>
            </form>

            <div id="form-success" class="hidden mt-4 p-4 rounded-md bg-brand-success/15 border border-brand-success/30 text-brand-success text-sm" role="alert" aria-live="polite">
              Thanks. I'll respond within one business day.
            </div>
          </section>
        </ScrollReveal>

        <ScrollReveal delay={2}>
          <section aria-labelledby="links-heading">
            <p class="eyebrow mb-6">Or reach me directly</p>
            <div class="space-y-6 mb-10">
              <a href="mailto:geraldaton20@gmail.com?subject=Consulting Inquiry" class="block group">
                <p class="text-sm font-medium text-brand-text group-hover:text-brand-accent transition-colors">Email</p>
                <p class="text-sm text-brand-muted">geraldaton20@gmail.com</p>
              </a>
              <a href="https://linkedin.com/in/geraldaton" target="_blank" rel="noopener noreferrer" class="block group">
                <p class="text-sm font-medium text-brand-text group-hover:text-brand-accent transition-colors">LinkedIn</p>
                <p class="text-sm text-brand-muted">linkedin.com/in/geraldaton</p>
              </a>
              <a href="https://github.com/sensesVoid" target="_blank" rel="noopener noreferrer" class="block group">
                <p class="text-sm font-medium text-brand-text group-hover:text-brand-accent transition-colors">GitHub</p>
                <p class="text-sm text-brand-muted">github.com/sensesVoid</p>
              </a>
            </div>

            <div class="border-t border-brand-border pt-8">
              <p class="eyebrow mb-3">Availability</p>
              <p class="text-sm text-brand-muted leading-relaxed">
                Currently accepting new consulting engagements. Based in the Philippines (UTC+8), available for async and sync collaboration across US, EU, and APAC time zones.
              </p>
            </div>
          </section>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const success = document.getElementById('form-success');
    const submitBtn = document.getElementById('submit-btn');

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('success') === '1') {
      form.classList.add('hidden');
      success.classList.remove('hidden');
    }

    form?.addEventListener('submit', () => {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    });
  </script>
</BaseLayout>
