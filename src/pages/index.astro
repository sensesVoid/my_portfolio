---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import Timeline from '@/components/Timeline.astro';
import Icon from '@/components/Icon.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featuredProject = projects.find(p => p.data.featured);
const otherProjects = projects.filter(p => !p.data.featured);
const scheduleUrl = import.meta.env.PUBLIC_CALENDLY_URL || '#contact';

const experience = [
  { period: 'Sep 2025 — Present', role: 'Content Moderator', company: 'Tech Mahindra Philippines', highlights: ['Major social platform, US-focused moderation'] },
  { period: 'Nov 2023 — Mar 2025', role: 'Email & Text FinTech Support', company: 'ECE Philippines', highlights: ['Albert app · 115% TPH · 65% CSAT · 78% quality'] },
  { period: 'Aug 2023 — Oct 2023', role: 'Customer Service Rep', company: 'Eperformax Philippines', highlights: ['T-Mobile · 95% CSAT · 50% NPS · <20 min AHT'] },
  { period: '2 years', role: 'Quality Analyst', company: 'Wipro BPO Philippines', highlights: ['Policy evaluation · Knowledge base → 100% site quality'] },
  { period: 'Apr 2019 — Aug 2023', role: 'Digital Content Specialist', company: 'Wipro BPO Philippines', highlights: ['Content review · Automation → 20% productivity gain'] },
];

const services = [
  {
    title: 'Trust & Safety Foundations',
    description: 'Policy frameworks, moderation pipelines, QA programs from scratch.',
    bullets: ['Policy framework and escalation paths', 'Moderation workflow and reviewer QA calibration', 'Tooling selection and quality baseline'],
    engagement: 'TODO: typical engagement length and format',
  },
  {
    title: 'Support Operations & QA',
    description: 'Fintech and consumer support scaling, productivity optimization, CSAT improvement.',
    bullets: ['Queue design and SLA/SLO definition', 'QA scorecards and coaching programs', 'Productivity tooling and domain expertise'],
    engagement: 'TODO: typical engagement length and format',
  },
  {
    title: 'AI Automation & Tooling',
    description: 'Custom agent workflows, SQAC integration, local LLM deployment.',
    bullets: ['Custom agent workflows and SQAC integration', 'Local LLM deployment (llama.cpp/GGUF)', 'RAG vs. memory architecture decisions'],
    engagement: 'TODO: typical engagement length and format',
  },
  {
    title: 'Fractional QA Lead',
    description: 'Embedded QA leadership: hiring, calibration, process design, reporting.',
    bullets: ['Hiring and calibration programs', 'Process design and tooling', 'Reporting and knowledge transfer'],
    engagement: 'TODO: typical engagement length and format',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Gerald B. Aton',
  url: 'https://gerald-aton.vercel.app',
  image: 'https://gerald-aton.vercel.app/gerald-aton-portrait.jpg',
  sameAs: ['https://linkedin.com/in/geraldaton', 'https://github.com/sensesVoid'],
  jobTitle: 'Trust & Safety Consultant',
  worksFor: { '@type': 'Organization', name: 'Independent' },
  knowsAbout: ['Content Moderation', 'Quality Assurance', 'Customer Support Operations', 'AI Agent Harnesses', 'LLM Memory Systems'],
};
---

<BaseLayout title="Gerald B. Aton — Trust & Safety + AI Automation" description="Trust & Safety operations, content moderation, and AI tooling for early-stage startups. 8 years of experience." jsonLd={jsonLd}>
  <!-- Hero -->
  <section id="top" class="relative min-h-screen flex items-center" aria-labelledby="hero-heading">
    <div class="relative max-w-7xl mx-0 px-2 sm:px-3 lg:px-4 py-24">
      <div class="max-w-2xl">
        <ScrollReveal delay={0}>
          <p class="eyebrow mb-6">Available for consulting</p>
        </ScrollReveal>
        <ScrollReveal delay={1}>
          <h1 id="hero-heading" class="font-display text-5xl sm:text-6xl lg:text-7xl font-medium leading-[1.02] tracking-tight text-brand-text mb-6">
            Gerald B. Aton
          </h1>
        </ScrollReveal>
        <ScrollReveal delay={2}>
          <p class="font-display text-2xl sm:text-3xl text-brand-accent mb-6 leading-snug">
            Trust & Safety Operations + AI Automation
          </p>
        </ScrollReveal>
        <ScrollReveal delay={3}>
          <p class="text-lg text-brand-muted max-w-xl leading-relaxed mb-4">
            I help early-stage startups build Trust & Safety and support operations that scale — and I build the AI tooling that makes those teams faster.
          </p>
          <p class="text-sm text-brand-muted max-w-xl leading-relaxed mb-8">
            The AI work (SQAC, agent harnesses) is built to support T&S teams with portable memory, faster review, and lower context cost.
          </p>
        </ScrollReveal>
        <ScrollReveal delay={4}>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-brand-muted mb-8">
            <span>8 yrs T&S / Support</span>
            <span>·</span>
            <span>100% site quality (Wipro KB)</span>
          </div>
        </ScrollReveal>
        <ScrollReveal delay={5}>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href={scheduleUrl} class="btn-primary">Book a discovery call</a>
            <a href="#projects" class="text-sm text-brand-muted hover:text-brand-text transition-colors inline-flex items-center gap-2 self-center">
              View work <span aria-hidden="true">→</span>
            </a>
            <a href="/resume.pdf" class="text-sm text-brand-muted hover:text-brand-text transition-colors inline-flex items-center gap-2 self-center" download>
              Download resume (PDF) <span aria-hidden="true">↓</span>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- About / Credentials -->
  <section id="about" class="section border-t border-brand-border" aria-labelledby="about-heading">
    <div class="container-custom">
      <div class="grid lg:grid-cols-[240px_1fr] gap-8 md:gap-16 mb-12">
        <div>
          <p class="eyebrow mb-3">01 — About</p>
          <h2 id="about-heading" class="font-display text-3xl sm:text-4xl font-medium text-brand-text">Credentials</h2>
        </div>
        <p class="text-brand-muted max-w-xl self-end">Content moderator, quality analyst, and customer support professional with eight years of experience. Self-directed AI builder.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <p class="eyebrow mb-4">Professional summary</p>
          <p class="text-brand-muted leading-relaxed">
            Content moderator, quality analyst and customer support professional with 8 years of experience in policy enforcement, US customer support, fintech, telecom and consumer technology. Proven results in quality, productivity and customer satisfaction, including a 20% productivity gain from an automation project and a policy knowledge base that earned a 100% site quality score. Self-directed AI builder, hands-on with AI agent harnesses, coding CLIs and local LLM tooling.
          </p>
          <p class="text-brand-muted leading-relaxed mt-4">
            I work by embedding with a team, mapping the real workflow, and building the smallest tool or process change that moves a metric — then handing it off so it survives without me.
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4">Core skills</p>
          <p class="text-sm text-brand-muted leading-relaxed">
            Content Moderation · Policy Enforcement · Quality Assurance · US Customer Support · Fintech Support · Workflow Automation · Knowledge Base Development · Python · JavaScript · SQL · AI Agent Harnesses
          </p>
          <p class="eyebrow mt-8 mb-4">Certifications</p>
          <ul class="space-y-1 text-sm text-brand-muted">
            <li>Data Analyst Associate (SQL, DataCamp)</li>
            <li><a href="https://www.kaggle.com/learn/certification/sensesvoid/intro-to-programming" class="link" target="_blank" rel="noopener noreferrer">Kaggle Learn — Intro to Programming</a></li>
            <li><a href="https://www.kaggle.com/learn/certification/sensesvoid/python" class="link" target="_blank" rel="noopener noreferrer">Kaggle Learn — Python</a></li>
            <li>NC II Contact Center Servicing (Springboard Career Academy)</li>
            <li>Career Service Professional Eligibility (CSC)</li>
            <li>Career Service Sub-Professional Eligibility (CSC)</li>
          </ul>
        </div>
      </div>

      <div class="mt-16">
        <p class="eyebrow mb-6">Experience</p>
        <Timeline title="" items={experience} />
        <p class="text-xs text-brand-muted mt-6">Legend: TPH = transactions per hour; AHT = average handle time; CSAT = customer satisfaction; NPS = net promoter score.</p>
        <p class="text-xs text-brand-muted mt-2">TODO: confirm exact dates for the Quality Analyst / Digital Content Specialist overlap at Wipro.</p>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="section border-t border-brand-border" aria-labelledby="projects-heading">
    <div class="container-custom">
      <div class="grid md:grid-cols-[240px_1fr] gap-8 md:gap-16 mb-12">
        <div>
          <p class="eyebrow mb-3">02 — Work</p>
          <h2 id="projects-heading" class="font-display text-3xl sm:text-4xl font-medium text-brand-text">Projects</h2>
        </div>
        <p class="text-brand-muted max-w-xl self-end">All public work at <a href="https://github.com/sensesVoid" class="link">github.com/sensesVoid</a>.</p>
      </div>

      {featuredProject && (
        <div class="mb-12">
          <p class="eyebrow mb-4">Featured</p>
          <h3 class="font-display text-3xl sm:text-4xl font-medium text-brand-text mb-2">{featuredProject.data.title}</h3>
          <p class="text-brand-muted mb-4 max-w-2xl">{featuredProject.data.description}</p>
          <p class="font-mono text-xs text-brand-muted mb-4">{featuredProject.data.stack.join(' · ')}</p>
          <a href={`/projects/${featuredProject.slug}`} class="text-sm text-brand-text hover:text-brand-accent transition-colors">View project →</a>
        </div>
      )}

      <div class="border-t border-brand-border">
        {otherProjects.map(p => (
          <div class="py-8 border-b border-brand-border">
            <h3 class="font-display text-2xl font-medium text-brand-text mb-2">{p.data.title}</h3>
            <p class="text-brand-muted mb-3 max-w-2xl">{p.data.description}</p>
            <a href={`/projects/${p.slug}`} class="text-sm text-brand-muted hover:text-brand-text transition-colors">View →</a>
          </div>
        ))}
        <div class="py-8 border-b border-brand-border">
          <p class="eyebrow mb-2">Case study (TODO)</p>
          <h3 class="font-display text-2xl font-medium text-brand-text mb-2">Trust & Safety workflow sample</h3>
          <p class="text-brand-muted mb-3 max-w-2xl">TODO: sanitized sample (policy framework, QA scorecard, or moderation workflow). No confidential employer details.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section border-t border-brand-border" aria-labelledby="services-heading">
    <div class="container-custom">
      <div class="grid md:grid-cols-[240px_1fr] gap-8 md:gap-16 mb-12">
        <div>
          <p class="eyebrow mb-3">03 — Services</p>
          <h2 id="services-heading" class="font-display text-3xl sm:text-4xl font-medium text-brand-text">How I help</h2>
        </div>
        <p class="text-brand-muted max-w-xl self-end">Four engagement areas for early-stage startups building Trust & Safety operations.</p>
      </div>
      <div class="border-t border-brand-border">
        {services.map((svc, i) => (
          <div class="grid md:grid-cols-[80px_1fr_2fr] gap-6 md:gap-10 py-8 border-b border-brand-border items-start">
            <p class="font-mono text-sm text-brand-muted">{String(i + 1).padStart(2, '0')}</p>
            <div>
              <h3 class="font-display text-xl font-medium text-brand-text mb-2">{svc.title}</h3>
              <p class="text-sm text-brand-muted mb-3">{svc.description}</p>
              <p class="text-xs text-brand-muted">Typical engagement: {svc.engagement}</p>
            </div>
            <div>
              <p class="eyebrow mb-3">What you get</p>
              <ul class="space-y-1">
                {svc.bullets.map(b => <li class="text-sm text-brand-muted leading-relaxed">{b}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12">
        <p class="eyebrow mb-4">How we work</p>
        <div class="grid sm:grid-cols-4 gap-6">
          {[
            { step: 'Discover', desc: 'Understand your current operations, metrics, and gaps.' },
            { step: 'Scope', desc: 'Agree on deliverables, timeline, and success criteria.' },
            { step: 'Deliver', desc: 'Implement process changes and the tooling to support them.' },
            { step: 'Handoff', desc: 'Document, train, and transfer ownership so it survives.' },
          ].map((item, i) => (
            <div key={item.step}>
              <p class="font-mono text-sm text-brand-muted mb-2">{String(i + 1).padStart(2, '0')}</p>
              <p class="font-display text-lg font-medium text-brand-text">{item.step}</p>
              <p class="text-sm text-brand-muted mt-1">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section border-t border-brand-border" aria-labelledby="contact-heading">
    <div class="container-custom">
      <div class="max-w-2xl mb-12">
        <p class="eyebrow mb-6">04 — Contact</p>
        <h2 id="contact-heading" class="font-display text-5xl sm:text-6xl font-medium text-brand-text leading-tight mb-6">
          Book a discovery call.
        </h2>
        <p class="text-brand-muted leading-relaxed">Tell me about your project. I respond within one business day.</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-16 border-t border-brand-border pt-12">
        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5" id="contact-form">
          <input type="hidden" name="access_key" value="7248bd8a-95ba-455e-b4d2-3423d099f1ef" />
          <input type="hidden" name="subject" value="New portfolio inquiry" />
          <input type="hidden" name="from_name" value="Portfolio Contact Form" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div>
            <label for="name" class="block text-sm font-medium text-brand-text mb-1">Name</label>
            <input type="text" id="name" name="name" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text placeholder-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent" placeholder="Your name" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-brand-text mb-1">Email</label>
            <input type="email" id="email" name="email" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text placeholder-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent" placeholder="you@example.com" />
          </div>
          <div>
            <label for="service" class="block text-sm font-medium text-brand-text mb-1">Service interest</label>
            <select id="service" name="service" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent">
              <option value="">Select...</option>
              <option value="trust-safety">Trust & Safety Foundations</option>
              <option value="support-qa">Support Operations & QA</option>
              <option value="ai-automation">AI Automation & Tooling</option>
              <option value="fractional-qa">Fractional QA Lead</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-brand-text mb-1">Message</label>
            <textarea id="message" name="message" rows="5" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text placeholder-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent resize-y" placeholder="Tell me about your project..."></textarea>
          </div>
          <button type="submit" class="btn-primary" id="submit-btn">Send message</button>
        </form>
        <div id="form-success" class="hidden mt-4 p-4 rounded-md bg-brand-success/15 border border-brand-success/30 text-brand-success text-sm" role="alert" aria-live="polite">
          Thanks. I'll respond within one business day.
        </div>
        <div id="form-error" class="hidden mt-4 p-4 rounded-md bg-red-500/15 border border-red-500/30 text-red-300 text-sm" role="alert" aria-live="polite">
          Something went wrong. Please try again or email me directly.
        </div>

        <div class="space-y-6">
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A017" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <div>
              <p class="eyebrow mb-1">Email</p>
              <a href="mailto:geraldaton20@gmail.com" class="text-brand-text hover:text-brand-accent transition-colors">geraldaton20@gmail.com</a>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A017" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            <div>
              <p class="eyebrow mb-1">LinkedIn</p>
              <a href="https://linkedin.com/in/geraldaton" target="_blank" rel="noopener noreferrer" class="text-brand-text hover:text-brand-accent transition-colors">linkedin.com/in/geraldaton</a>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D4A017" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            <div>
              <p class="eyebrow mb-1">GitHub</p>
              <a href="https://github.com/sensesVoid" target="_blank" rel="noopener noreferrer" class="text-brand-text hover:text-brand-accent transition-colors">github.com/sensesVoid</a>
            </div>
          </div>
          <div class="border-t border-brand-border pt-6">
            <p class="eyebrow mb-3">Availability</p>
            <p class="text-sm text-brand-muted leading-relaxed">Currently accepting new consulting engagements. Based in the Philippines (UTC+8), available for async and sync collaboration across US, EU, and APAC time zones.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      const form = document.getElementById('contact-form');
      const submitBtn = document.getElementById('submit-btn');
      const success = document.getElementById('form-success');
      const error = document.getElementById('form-error');
      if (!form) return;

      function showError(field, msg) {
        let el = form.querySelector('[data-error-for="' + field + '"]');
        if (!el) {
          el = document.createElement('p');
          el.className = 'text-xs text-red-300 mt-1';
          el.setAttribute('data-error-for', field);
          const input = form.querySelector('#' + field);
          input?.parentElement?.appendChild(el);
        }
        el.textContent = msg;
      }
      function clearError(field) {
        const el = form.querySelector('[data-error-for="' + field + '"]');
        if (el) el.textContent = '';
      }

      form.querySelectorAll('input, textarea, select').forEach(el => {
        el.addEventListener('blur', () => {
          if (el.hasAttribute('required') && !el.value.trim()) {
            showError(el.id, 'This field is required.');
          } else if (el.type === 'email' && el.value && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(el.value)) {
            showError(el.id, 'Enter a valid email.');
          } else {
            clearError(el.id);
          }
        });
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        success.classList.add('hidden');
        error.classList.add('hidden');
        // honeypot
        const botcheck = form.querySelector('input[name="botcheck"]');
        if (botcheck && botcheck.checked) return;

        let valid = true;
        form.querySelectorAll('[required]').forEach(el => {
          if (!el.value.trim()) { showError(el.id, 'This field is required.'); valid = false; }
          else clearError(el.id);
        });
        const email = form.querySelector('#email');
        if (email && email.value && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email.value)) {
          showError('email', 'Enter a valid email.'); valid = false;
        }
        if (!valid) return;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
        try {
          const formData = new FormData(form);
          formData.set('subject', `New portfolio inquiry: ${formData.get('service') || 'General'}`);
          formData.set('from_name', formData.get('name') || 'Portfolio Contact');
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData,
          });
          const result = await res.json();
          if (result.success) {
            form.reset();
            success.classList.remove('hidden');
          } else {
            console.error('Web3Forms error:', result);
            error.classList.remove('hidden');
          }
        } catch (err) {
          console.error('Submit error:', err);
          error.classList.remove('hidden');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send message';
        }
      });
    })();
  </script>
</BaseLayout>
