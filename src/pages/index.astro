---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
import Timeline from '@/components/Timeline.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featuredProject = projects.find(p => p.data.featured);
const otherProjects = projects.filter(p => !p.data.featured);

const experience = [
  { period: 'Sep 2025 — Present', role: 'Content Moderator', company: 'Tech Mahindra Philippines', highlights: ['Major social platform, US-focused moderation'] },
  { period: 'Nov 2023 — Mar 2025', role: 'Email & Text FinTech Support', company: 'ECE Philippines', highlights: ['Albert app · 115% TPH · 65% CSAT · 78% quality'] },
  { period: 'Aug 2023 — Oct 2023', role: 'Customer Service Rep', company: 'Eperformax Philippines', highlights: ['T-Mobile · 95% CSAT · 50% NPS · <20 min AHT'] },
  { period: '2 years', role: 'Quality Analyst', company: 'Wipro BPO Philippines', highlights: ['Policy evaluation · Knowledge base → 100% site quality'] },
  { period: 'Apr 2019 — Aug 2023', role: 'Digital Content Specialist', company: 'Wipro BPO Philippines', highlights: ['Content review · Automation → 20% productivity gain'] },
];

const services = [
  { title: 'Trust & Safety Foundations', description: 'Policy frameworks, moderation pipelines, QA programs from scratch.' },
  { title: 'Support Operations & QA', description: 'Fintech and consumer support scaling, productivity optimization, CSAT improvement.' },
  { title: 'AI Automation & Tooling', description: 'Custom agent workflows, SQAC integration, local LLM deployment.' },
  { title: 'Fractional QA Lead', description: 'Embedded QA leadership: hiring, calibration, process design, reporting.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Gerald B. Aton',
  url: 'https://myportfolio-theta-plum-30.vercel.app',
  image: 'https://myportfolio-theta-plum-30.vercel.app/Modern Dark Studio Portrait.png',
  sameAs: ['https://linkedin.com/in/geraldaton', 'https://github.com/sensesVoid'],
  jobTitle: 'Trust & Safety Consultant',
  worksFor: { '@type': 'Organization', name: 'Independent' },
  knowsAbout: ['Content Moderation', 'Quality Assurance', 'Customer Support Operations', 'AI Agent Harnesses', 'LLM Memory Systems'],
};
---

<BaseLayout title="Gerald B. Aton — Trust & Safety + AI Automation" description="Trust & Safety operations, content moderation, and AI tooling for early-stage startups. 8 years of experience." jsonLd={jsonLd}>
  <!-- Hero -->
  <section id="top" class="relative min-h-screen flex items-center" aria-labelledby="hero-heading">
    <div class="relative container-custom py-24">
      <div class="max-w-2xl">
        <ScrollReveal delay={0}>
          <p class="eyebrow mb-6">Available for consulting</p>
        </ScrollReveal>
        <ScrollReveal delay={1}>
          <h1 id="hero-heading" class="font-display text-5xl sm:text-6xl lg:text-7xl font-medium leading-[1.02] tracking-tight text-brand-text mb-6">
            Gerald B. Aton
          </h1>
        </ScrollReveal>
        <ScrollReveal delay={2}>
          <p class="font-display text-2xl sm:text-3xl text-brand-accent mb-6 leading-snug">
            Trust & Safety Operations + AI Automation
          </p>
        </ScrollReveal>
        <ScrollReveal delay={3}>
          <p class="text-lg text-brand-muted max-w-xl leading-relaxed mb-8">
            8 years scaling content moderation, QA, and US customer support. I build the tooling your team wishes existed — like SQAC, a portable memory layer for LLMs.
          </p>
        </ScrollReveal>
        <ScrollReveal delay={4}>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-brand-muted mb-8">
            <span>8 yrs T&S / Support</span>
            <span>·</span>
            <span>100% site quality (Wipro KB)</span>
            <span>·</span>
            <span>20% productivity gain</span>
            <span>·</span>
            <span>95% CSAT (T-Mobile)</span>
          </div>
        </ScrollReveal>
        <ScrollReveal delay={5}>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#contact" class="btn-primary">Book a discovery call</a>
            <a href="#projects" class="text-sm text-brand-muted hover:text-brand-text transition-colors inline-flex items-center gap-2 self-center">
              View work <span aria-hidden="true">→</span>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- About / Credentials -->
  <section id="about" class="section border-t border-brand-border" aria-labelledby="about-heading">
    <div class="container-custom">
      <div class="grid lg:grid-cols-[240px_1fr] gap-8 md:gap-16 mb-12">
        <div>
          <p class="eyebrow mb-3">01 — About</p>
          <h2 id="about-heading" class="font-display text-3xl sm:text-4xl font-medium text-brand-text">Credentials</h2>
        </div>
        <p class="text-brand-muted max-w-xl self-end">Content moderator, quality analyst, and customer support professional with eight years of experience. Self-directed AI builder.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <p class="eyebrow mb-4">Professional summary</p>
          <p class="text-brand-muted leading-relaxed">
            Content moderator, quality analyst and customer support professional with 8 years of experience in policy enforcement, US customer support, fintech, telecom and consumer technology. Proven results in quality, productivity and customer satisfaction, including a 20% productivity gain from an automation project and a policy knowledge base that earned a 100% site quality score. Self-directed AI builder, hands-on with AI agent harnesses, coding CLIs and local LLM tooling.
          </p>
        </div>
        <div>
          <p class="eyebrow mb-4">Core skills</p>
          <p class="text-sm text-brand-muted leading-relaxed">
            Content Moderation · Policy Enforcement · Quality Assurance · US Customer Support · Fintech Support · Workflow Automation · Knowledge Base Development · Python · JavaScript · SQL · AI Agent Harnesses
          </p>
          <p class="eyebrow mt-8 mb-4">Certifications</p>
          <ul class="space-y-1 text-sm text-brand-muted">
            <li>Data Analyst Associate (SQL, DataCamp)</li>
            <li>NC II Contact Center Servicing (Springboard Career Academy)</li>
            <li>Career Service Professional Eligibility (CSC)</li>
            <li>Career Service Sub-Professional Eligibility (CSC)</li>
          </ul>
        </div>
      </div>

      <div class="mt-16">
        <p class="eyebrow mb-6">Experience</p>
        <Timeline title="" items={experience} />
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="section border-t border-brand-border" aria-labelledby="projects-heading">
    <div class="container-custom">
      <div class="grid md:grid-cols-[240px_1fr] gap-8 md:gap-16 mb-12">
        <div>
          <p class="eyebrow mb-3">02 — Work</p>
          <h2 id="projects-heading" class="font-display text-3xl sm:text-4xl font-medium text-brand-text">Projects</h2>
        </div>
        <p class="text-brand-muted max-w-xl self-end">All public work at <a href="https://github.com/sensesVoid" class="link">github.com/sensesVoid</a>.</p>
      </div>

      {featuredProject && (
        <div class="mb-12">
          <p class="eyebrow mb-4">Featured</p>
          <h3 class="font-display text-3xl sm:text-4xl font-medium text-brand-text mb-2">{featuredProject.data.title}</h3>
          <p class="text-brand-muted mb-4 max-w-2xl">{featuredProject.data.description}</p>
          <p class="font-mono text-xs text-brand-muted mb-4">{featuredProject.data.stack.join(' · ')}</p>
          <a href={`/projects/${featuredProject.slug}`} class="text-sm text-brand-text hover:text-brand-accent transition-colors">View project →</a>
        </div>
      )}

      <div class="border-t border-brand-border">
        {otherProjects.map(p => (
          <div class="py-8 border-b border-brand-border">
            <h3 class="font-display text-2xl font-medium text-brand-text mb-2">{p.data.title}</h3>
            <p class="text-brand-muted mb-3 max-w-2xl">{p.data.description}</p>
            <a href={`/projects/${p.slug}`} class="text-sm text-brand-muted hover:text-brand-text transition-colors">View →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section border-t border-brand-border" aria-labelledby="services-heading">
    <div class="container-custom">
      <div class="grid md:grid-cols-[240px_1fr] gap-8 md:gap-16 mb-12">
        <div>
          <p class="eyebrow mb-3">03 — Services</p>
          <h2 id="services-heading" class="font-display text-3xl sm:text-4xl font-medium text-brand-text">How I help</h2>
        </div>
        <p class="text-brand-muted max-w-xl self-end">Four engagement areas for early-stage startups building Trust & Safety operations.</p>
      </div>
      <div class="border-t border-brand-border">
        {services.map((svc, i) => (
          <div class="grid md:grid-cols-[80px_1fr_2fr] gap-6 md:gap-10 py-8 border-b border-brand-border items-start">
            <p class="font-mono text-sm text-brand-muted">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="font-display text-xl font-medium text-brand-text">{svc.title}</h3>
            <p class="text-brand-muted leading-relaxed">{svc.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section border-t border-brand-border" aria-labelledby="contact-heading">
    <div class="container-custom">
      <div class="max-w-2xl mb-12">
        <p class="eyebrow mb-6">04 — Contact</p>
        <h2 id="contact-heading" class="font-display text-5xl sm:text-6xl font-medium text-brand-text leading-tight mb-6">
          Book a discovery call.
        </h2>
        <p class="text-brand-muted leading-relaxed">Tell me about your project. I respond within one business day.</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-16 border-t border-brand-border pt-12">
        <form action="/api/contact" method="POST" class="space-y-5" id="contact-form">
          <input type="hidden" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
          <div>
            <label for="name" class="block text-sm font-medium text-brand-text mb-1">Name</label>
            <input type="text" id="name" name="name" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text placeholder-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent" placeholder="Your name" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-brand-text mb-1">Email</label>
            <input type="email" id="email" name="email" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text placeholder-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent" placeholder="you@example.com" />
          </div>
          <div>
            <label for="service" class="block text-sm font-medium text-brand-text mb-1">Service interest</label>
            <select id="service" name="service" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent">
              <option value="">Select...</option>
              <option value="trust-safety">Trust & Safety Foundations</option>
              <option value="support-qa">Support Operations & QA</option>
              <option value="ai-automation">AI Automation & Tooling</option>
              <option value="fractional-qa">Fractional QA Lead</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-brand-text mb-1">Message</label>
            <textarea id="message" name="message" rows="5" required class="w-full rounded-md border border-brand-border bg-brand-bg px-4 py-3 text-brand-text placeholder-brand-muted focus:outline-none focus:ring-2 focus:ring-brand-accent focus:border-transparent resize-y" placeholder="Tell me about your project..."></textarea>
          </div>
          <button type="submit" class="btn-primary" id="submit-btn">Send message</button>
        </form>

        <div class="space-y-6">
          <div>
            <p class="eyebrow mb-3">Email</p>
            <a href="mailto:geraldaton20@gmail.com" class="text-brand-text hover:text-brand-accent transition-colors">geraldaton20@gmail.com</a>
          </div>
          <div>
            <p class="eyebrow mb-3">LinkedIn</p>
            <a href="https://linkedin.com/in/geraldaton" target="_blank" rel="noopener noreferrer" class="text-brand-text hover:text-brand-accent transition-colors">linkedin.com/in/geraldaton</a>
          </div>
          <div>
            <p class="eyebrow mb-3">GitHub</p>
            <a href="https://github.com/sensesVoid" target="_blank" rel="noopener noreferrer" class="text-brand-text hover:text-brand-accent transition-colors">github.com/sensesVoid</a>
          </div>
          <div class="border-t border-brand-border pt-6">
            <p class="eyebrow mb-3">Availability</p>
            <p class="text-sm text-brand-muted leading-relaxed">Currently accepting new consulting engagements. Based in the Philippines (UTC+8), available for async and sync collaboration across US, EU, and APAC time zones.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    form?.addEventListener('submit', () => {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    });
  </script>
</BaseLayout>
