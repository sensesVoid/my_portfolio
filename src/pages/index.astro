---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import TrustSignal from '@/components/TrustSignal.astro';
import { getEntry, getCollection } from 'astro:content';

const page = await getEntry('pages', 'index');
const projects = await getCollection('projects');
const featuredProject = projects.find(p => p.data.featured);
const otherProjects = projects.filter(p => !p.data.featured).slice(0, 3);

const services = [
  { title: 'Trust & Safety Foundations', description: 'Policy frameworks, moderation pipelines, QA programs from scratch.', href: '/services' },
  { title: 'Support Operations & QA', description: 'Fintech and consumer support scaling, productivity optimization, CSAT improvement.', href: '/services' },
  { title: 'AI Automation & Tooling', description: 'Custom agent workflows, SQAC integration, local LLM deployment.', href: '/services' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Gerald B. Aton',
  url: 'https://myportfolio-theta-plum-30.vercel.app',
  sameAs: [
    'https://linkedin.com/in/geraldaton',
    'https://github.com/sensesVoid',
  ],
  jobTitle: 'Trust & Safety Consultant',
  worksFor: { '@type': 'Organization', name: 'Independent' },
  knowsAbout: ['Content Moderation', 'Quality Assurance', 'Customer Support Operations', 'AI Agent Harnesses', 'LLM Memory Systems'],
};
---

<BaseLayout title={page.data.title} description={page.data.description} jsonLd={jsonLd}>
  <Hero {...page.data.hero} />

  {/* Trust Signals */}
  <section class="border-y border-brand-border" aria-label="Trust signals">
    <div class="container-custom py-12">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-0">
        {page.data.trustSignals?.map((signal, i) => (
          <TrustSignal key={signal.label} {...signal} index={i} />
        ))}
      </div>
    </div>
  </section>

  {/* Featured Project */}
  {featuredProject && (
    <section class="section" aria-labelledby="featured-heading">
      <div class="container-custom">
        <p class="eyebrow mb-8">01 — Featured Project</p>
        <ProjectCard {...featuredProject.data} href={`/projects/${featuredProject.slug}`} featured={true} />
      </div>
    </section>
  )}

  {/* Services */}
  <section class="section border-t border-brand-border" aria-labelledby="services-preview-heading">
    <div class="container-custom">
      <div class="grid md:grid-cols-[240px_1fr] gap-8 md:gap-16 mb-12">
        <div>
          <p class="eyebrow mb-3">02 — Services</p>
          <h2 id="services-preview-heading" class="font-display text-3xl sm:text-4xl font-medium text-brand-text">How I help</h2>
        </div>
        <p class="text-brand-muted max-w-xl self-end">Three engagement areas for early-stage startups building Trust & Safety operations.</p>
      </div>
      <div>
        {services.map((svc, i) => <ServiceCard key={svc.title} {...svc} index={i + 1} />)}
      </div>
      <div class="mt-12">
        <a href="/services" class="text-sm text-brand-muted hover:text-brand-text transition-colors inline-flex items-center gap-2">
          All services <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {/* Other Projects */}
  {otherProjects.length > 0 && (
    <section class="section border-t border-brand-border" aria-labelledby="projects-heading">
      <div class="container-custom">
        <div class="grid md:grid-cols-[240px_1fr] gap-8 md:gap-16 mb-12">
          <div>
            <p class="eyebrow mb-3">03 — Work</p>
            <h2 id="projects-heading" class="font-display text-3xl sm:text-4xl font-medium text-brand-text">Other projects</h2>
          </div>
          <p class="text-brand-muted max-w-xl self-end">All public work at <a href="https://github.com/sensesVoid" class="link">github.com/sensesVoid</a>.</p>
        </div>
        <div>
          {otherProjects.map(p => <ProjectCard key={p.slug} {...p.data} href={`/projects/${p.slug}`} />)}
        </div>
        <div class="mt-12">
          <a href="/projects" class="text-sm text-brand-muted hover:text-brand-text transition-colors inline-flex items-center gap-2">
            All projects <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>