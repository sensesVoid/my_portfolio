---
interface Props {
  title: string;
  description: string;
  href: string;
  index?: number;
}
const { title, description, href, index = 1 } = Astro.props;
const num = String(index).padStart(2, '0');
---
<article class="group py-8 border-t border-brand-border last:border-b">
  <div class="grid md:grid-cols-[80px_1fr_1fr] gap-6 md:gap-10 items-start">
    <p class="font-mono text-sm text-brand-muted">{num}</p>
    <div>
      <h3 class="font-display text-2xl font-medium text-brand-text mb-3 group-hover:text-brand-accent transition-colors">{title}</h3>
      <a href={href} class="text-sm text-brand-muted hover:text-brand-text transition-colors inline-flex items-center gap-2">
        Learn more <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="text-brand-muted leading-relaxed">{description}</p>
  </div>
</article>
