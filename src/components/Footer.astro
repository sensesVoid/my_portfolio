---
import Icon from '@/components/Icon.astro';
const currentYear = new Date().getFullYear();
const socialLinks = [
  { href: 'mailto:geraldaton20@gmail.com', label: 'Email', icon: 'mail' },
  { href: 'https://linkedin.com/in/geraldaton', label: 'LinkedIn', icon: 'linkedin' },
  { href: 'https://github.com/sensesVoid', label: 'GitHub', icon: 'github' },
];
---
<footer class="border-t border-brand-border">
  <div class="container-custom py-12 lg:py-16">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8">
      <div>
        <p class="font-display text-2xl font-medium text-brand-text mb-2">Gerald B. Aton</p>
        <p class="text-sm text-brand-muted max-w-sm">Trust & Safety operations, content moderation, and AI tooling for early-stage startups.</p>
      </div>
      <div class="flex flex-col items-start md:items-end gap-4">
        <div class="flex items-center gap-5">
          {socialLinks.map(link => (
            <a href={link.href} class="text-brand-muted hover:text-brand-text transition-colors" aria-label={link.label} target="_blank" rel="noopener noreferrer">
              <Icon name={link.icon} size={18} />
            </a>
          ))}
        </div>
        <a href="/resume.pdf" class="text-xs text-brand-muted hover:text-brand-text transition-colors" download>Download resume (PDF)</a>
        <p class="text-xs text-brand-muted">© {currentYear} Gerald B. Aton</p>
      </div>
    </div>
  </div>
</footer>
