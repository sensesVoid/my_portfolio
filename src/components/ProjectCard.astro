---
interface Props {
  title: string;
  description: string;
  stack: string[];
  github?: string;
  demo?: string;
  featured?: boolean;
  tags: string[];
  href: string;
}
const { title, description, stack, github, demo, featured, tags, href } = Astro.props;
---
<article class={`group py-10 border-t border-brand-border ${featured ? '' : ''}`}>
  <div class="grid md:grid-cols-[1fr_2fr] gap-6 md:gap-12 items-start">
    <div>
      <p class="eyebrow mb-3">{featured ? 'Featured Project' : 'Project'}</p>
      <h3 class="font-display text-3xl sm:text-4xl font-medium text-brand-text leading-tight mb-4 group-hover:text-brand-accent transition-colors">
        <a href={href}>{title}</a>
      </h3>
      {tags && tags.length > 0 && (
        <p class="font-mono text-xs text-brand-muted">{tags.join(' · ')}</p>
      )}
    </div>
    <div>
      <p class="text-brand-muted leading-relaxed mb-6">{description}</p>
      {stack && stack.length > 0 && (
        <p class="font-mono text-xs text-brand-muted mb-6">{stack.join(' · ')}</p>
      )}
      <div class="flex items-center gap-6 text-sm">
        <a href={href} class="text-brand-text hover:text-brand-accent transition-colors inline-flex items-center gap-2">
          View project <span aria-hidden="true">→</span>
        </a>
        {github && <a href={github} class="text-brand-muted hover:text-brand-text transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>}
        {demo && <a href={demo} class="text-brand-muted hover:text-brand-text transition-colors" target="_blank" rel="noopener noreferrer">Live demo</a>}
      </div>
    </div>
  </div>
</article>
