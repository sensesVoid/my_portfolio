---
import ScrollReveal from '@/components/ScrollReveal.astro';
interface Props {
  headline: string;
  subhead: string;
  ctaPrimary: { text: string; href: string };
  ctaSecondary?: { text: string; href: string };
  badge?: string;
}
const { headline, subhead, ctaPrimary, ctaSecondary, badge } = Astro.props;
// Support **accent** markers: render as accent-colored spans
const raw = headline.split('**');
const parts = [];
raw.forEach((text, i) => {
  if (text.length === 0) return;
  parts.push({ text, accent: i % 2 === 1 });
});
---
<section class="section pt-24 lg:pt-32" aria-labelledby="hero-heading">
  <div class="container-custom">
    <div class="max-w-4xl">
      {badge && (
        <ScrollReveal delay={0} class="mb-8">
          <p class="eyebrow">{badge}</p>
        </ScrollReveal>
      )}
      <h1 id="hero-heading" class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-medium leading-[1.02] tracking-tight text-brand-text mb-8">
        {parts.map((part, i) => (
          <ScrollReveal key={i} delay={1} class="inline">
            {part.accent ? <em class="not-italic text-brand-accent">{part.text}</em> : part.text}
          </ScrollReveal>
        ))}
      </h1>
      <ScrollReveal delay={2} class="mb-10">
        <p class="text-lg sm:text-xl text-brand-muted max-w-2xl leading-relaxed">{subhead}</p>
      </ScrollReveal>
      <ScrollReveal delay={3} class="flex flex-col sm:flex-row sm:items-center gap-6">
        <a href={ctaPrimary.href} class="btn-primary">{ctaPrimary.text}</a>
        {ctaSecondary && (
          <a href={ctaSecondary.href} class="text-sm text-brand-muted hover:text-brand-text transition-colors inline-flex items-center gap-2">
            {ctaSecondary.text} <span aria-hidden="true">→</span>
          </a>
        )}
      </ScrollReveal>
    </div>
  </div>
</section>