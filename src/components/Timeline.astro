---
interface TimelineItem {
  period: string;
  role: string;
  company: string;
  highlights: string[];
}
interface Props {
  items: TimelineItem[];
  title: string;
}
const { items, title } = Astro.props;
---
<section aria-labelledby={title ? title.toLowerCase().replace(/\s+/g, '-') : undefined}>
  {title && <h2 id={title.toLowerCase().replace(/\s+/g, '-')} class="font-display text-2xl font-medium text-brand-text mb-8">{title}</h2>}
  <div class="space-y-8">
    {items.map((item, i) => (
      <div key={i} class="grid md:grid-cols-[180px_1fr] gap-4 md:gap-10 py-6 border-t border-brand-border first:border-t-0">
        <p class="font-mono text-xs text-brand-muted pt-1">{item.period}</p>
        <div>
          <h3 class="font-display text-xl font-medium text-brand-text mb-1">{item.role}</h3>
          <p class="text-sm text-brand-accent mb-3">{item.company}</p>
          <ul class="space-y-1">
            {item.highlights.map((h, j) => (
              <li key={j} class="text-sm text-brand-muted leading-relaxed">{h}</li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
