---
import ScrollReveal from '@/components/ScrollReveal.astro';
interface Props {
  label: string;
  value: string;
  icon?: string;
  index: number;
}
const { label, value, index } = Astro.props;
---
<ScrollReveal delay={index + 1}>
  <div class="py-6 border-t border-brand-border first:border-t-0 md:border-t-0 md:border-l md:first:border-l-0 md:pl-6 md:first:pl-0">
    <p class="font-display text-4xl sm:text-5xl font-medium text-brand-text leading-none mb-2">{value}</p>
    <p class="eyebrow">{label}</p>
  </div>
</ScrollReveal>
