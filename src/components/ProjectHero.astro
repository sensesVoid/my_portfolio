---
interface Props {
  title: string;
  subtitle: string;
  badges: string[];
  links: { text: string; href: string }[];
  stack: string[];
}
const { title, subtitle, badges, links, stack } = Astro.props;
---
<header class="mb-12">
  <p class="eyebrow mb-4">Project</p>
  <h1 class="font-display text-5xl sm:text-6xl font-medium text-brand-text leading-tight mb-4">{title}</h1>
  <p class="text-lg text-brand-muted mb-8 max-w-3xl">{subtitle}</p>
  {badges && badges.length > 0 && (
    <p class="font-mono text-xs text-brand-muted mb-8">{badges.join(' · ')}</p>
  )}
  {links && links.length > 0 && (
    <div class="flex flex-wrap gap-6 mb-8 text-sm">
      {links.map(l => <a key={l.href} href={l.href} class="text-brand-text hover:text-brand-accent transition-colors" target="_blank" rel="noopener noreferrer">{l.text} →</a>)}
    </div>
  )}
  {/* Tech stack is shown via badges above; avoid duplicate list. */}
</header>